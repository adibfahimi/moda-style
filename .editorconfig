# EditorConfig — https://editorconfig.org
# Keep formatting consistent for everyone, regardless of editor/IDE.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source is indented with tabs by gofmt.
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require tabs for recipe lines.
[Makefile]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
